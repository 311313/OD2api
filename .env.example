# 管理令牌：仅库中无令牌时迁入一次，之后改这里不生效；面板设置页可轮换\n# ADMIN_TOKEN=\n# 下游调用本网关的 key（下游网关的渠道里填这个）
GATEWAY_API_KEY=

# 管理面板令牌，留空则免登录
ADMIN_TOKEN=

# 单请求最多尝试几个账号
MAX_ATTEMPTS=4

# 余额低于该值（USD）时暂停使用该号
MIN_BALANCE_USD=0.0005

# 单号并发上限
PER_ACCOUNT_CONCURRENCY=8

# 单号最小请求间隔（毫秒）
MIN_REQUEST_GAP_MS=800

# 单号每日请求上限
DAILY_REQUEST_CAP=1500

# 账号数据刷新间隔（分钟）
BALANCE_REFRESH_MINUTES=5

# 模型列表刷新间隔（分钟）
MODEL_REFRESH_MINUTES=60

# 剥离上游私有字段（extra_fields）与重复的 reasoning_details
STRIP_EXTRA_FIELDS=true

# 把下发行里的 model 名回写成下游请求的名字
REWRITE_MODEL_NAME=true

# 日志保留
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=50000

# 粘性会话 TTL（毫秒）
STICKY_TTL_MS=1800000
