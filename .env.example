# 管理令牌：仅库中无令牌时迁入一次，之后改这里不生效；面板设置页可轮换\n# ADMIN_TOKEN=\n# 下游调用本网关的 key（下游网关的渠道里填这个）
GATEWAY_API_KEY=

# 管理面板令牌，留空则免登录
ADMIN_TOKEN=

# 单请求最多尝试几个账号
MAX_ATTEMPTS=4

# 余额低于该值（USD）时暂停使用该号
MIN_BALANCE_USD=0.0005

# 单号并发上限
PER_ACCOUNT_CONCURRENCY=8

# 单号最小请求间隔（毫秒）
MIN_REQUEST_GAP_MS=800

# 单号每日请求上限
DAILY_REQUEST_CAP=1500

# 账号数据刷新间隔（分钟）
BALANCE_REFRESH_MINUTES=5

# 模型列表刷新间隔（分钟）
MODEL_REFRESH_MINUTES=60

# 剥离上游私有字段（extra_fields）与重复的 reasoning_details
STRIP_EXTRA_FIELDS=true

# 把下发行里的 model 名回写成下游请求的名字
REWRITE_MODEL_NAME=true

# 日志保留
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=50000

# 粘性会话 TTL（毫秒）
STICKY_TTL_MS=1800000

# 是否允许面板触发自更新。宿主机装好 scripts/auto-update.sh 的 cron 后设为 1；
# 不设则面板的"立即更新"按钮不可用（避免点了只会空等）。
SELF_UPDATE=0

# 可选：接入下游网关所在的 docker 网络名。设置后配合
# docker-compose.upstream.yml 使用；留空则只挂默认网络。
# UPSTREAM_NETWORK=

# 后台查询 GitHub 最新版本的间隔（分钟）。默认 10。
# 面板据此显示"有新版本"，不需要手动点检查。
# 调小会更及时发现更新，但 GitHub 未认证限流是 60 次/小时，别设太小。
# VERSION_POLL_MINUTES=10
